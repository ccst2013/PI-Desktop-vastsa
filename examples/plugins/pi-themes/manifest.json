{
 "schemaVersion": 1,
 "id": "ccst.pi-themes",
 "name": "Hello",
 "version": "0.3.0",
 "description": "PI-Desktop 示例插件：命令面板 + 面板 + Echo Tool + 技能 / 主题 / 常驻服务 / 消息总线",
 "author": "PI-Desktop",
 "main": "main.cjs",
 "ui": {
 "panel": "renderer/index.html",
 "width": 420,
 "height": 320,
 "title": {
   "en": "Hello Plugin",
   "zh-CN": "你好插件"
 }
 },
 "contributes": {
 "views": [
 {
 "id": "greetings",
 "title": {
   "en": "Hello Panel",
   "zh-CN": "你好面板"
 },
 "icon": "sparkles",
 "entry": "views/greetings.html",
 "order": 10
 }
 ],
 "commands": [
 {
 "id": "hello.open",
 "title": "Hello: Open Panel",
 "keywords": ["hello", "你好", "demo"],
 "category": "Demo"
 }
 ],
 "agentTools": [
 {
 "name": "echo_text",
 "description": "Echo text back to the agent",
 "risk": "low",
 "schema": {
 "type": "object",
 "properties": {
 "text": { "type": "string" }
 },
 "required": ["text"]
 }
 }
 ],
 "skills": ["./skills/hello.md"],
 "themes": [
 {
 "id": "midnight",
 "label": "Midnight",
 "path": "themes/midnight.css",
 "base": "dark"
 },
 {
 "id": "glass",
 "label": "Aurora · 淡光",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-ember",
 "label": "Ember · 浅杏",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-abyss",
 "label": "Abyss · 浅海",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-graphite",
 "label": "Graphite · 晨雾",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-peach",
 "label": "Peach · 蜜桃",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-lemon",
 "label": "Lemon · 浅柠",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-matcha",
 "label": "Matcha · 抹茶",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-mint",
 "label": "Mint · 薄荷",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-iris",
 "label": "Iris · 鸢尾",
 "path": "themes/glass.css",
 "base": "light"
 },
 {
 "id": "glass-ocean",
 "label": "Ocean · 暮海",
 "path": "themes/glass.css",
 "base": "dark"
 },
 {
 "id": "glass-plum",
 "label": "Plum · 夜梅",
 "path": "themes/glass.css",
 "base": "dark"
 },
 {
 "id": "glass-obsidian",
 "label": "Obsidian · 曜岩",
 "path": "themes/glass.css",
 "base": "dark"
 }
 ],
 "services": [
 {
 "id": "greeter",
 "label": "Greeter heartbeat"
 }
 ],
 "bus": {
 "publish": ["ccst.pi-themes.greeted", "ccst.pi-themes.tick"],
 "subscribe": ["demo.**"]
 },
 "settings": [
 {
 "key": "greeting",
 "type": "string",
 "default": "Hello from plugin",
 "title": "Greeting"
 }
 ]
 },
 "permissions": [
 "ui.panel",
 "ui.view",
 "ui.theme",
 "agent.tool.register",
 "agent.prompt.inject",
 "background.service",
 "bus.publish",
 "bus.subscribe"
 ],
 "engines": {
 "piDesktop": ">=0.1.0"
 },
 "activationEvents": [
 "onCommand:hello.open",
 "onStartup"
 ]
}
